      "violations": [
        {
          "rule_id": "TP-CONFIG-004",
          "rule_name": "任务队列必须有界",
          "message": "pool (executors_factory) 使用了无界队列 LinkedBlockingQueue：不指定容量时最大长度为 Integer.MAX_VALUE，视为无界。",
          "severity": "error",
          "line": 9,
          "column": 42,
          "snippet": "private final ExecutorService pool = Executors.newFixedThreadPool(2);",
          "suggestion": "改用 new ArrayBlockingQueue<>(capacity) 并显式给出容量（可参照 Q ≈ (λ_in − λ_out) × Δt 估算），同时配置拒绝策略。"
        },
        {
          "rule_id": "TP-CREATE-001",
          "rule_name": "显式创建线程池",
          "message": "Executors.newFixedThreadPool(...) 隐藏了队列与拒绝策略：内部使用无界 LinkedBlockingQueue（容量 Integer.MAX_VALUE），任务会持续堆积直至 OOM。",
          "severity": "error",
          "line": 9,
          "column": 42,
          "snippet": "private final ExecutorService pool = Executors.newFixedThreadPool(2);",
          "suggestion": "改为 new ThreadPoolExecutor(corePoolSize, maximumPoolSize, keepAliveTime, unit, new ArrayBlockingQueue<>(capacity), threadFactory, rejectionHandler)，把线程数、队列容量、命名工厂和拒绝策略显式写出。"
        },
        {
          "rule_id": "TP-CREATE-003",
          "rule_name": "线程池必须配置线程工厂",
          "message": "pool (executors_factory) 没有指定 ThreadFactory，工作线程会使用 pool-N-thread-M 这类默认名称。",
          "severity": "warning",
          "line": 9,
          "column": 42,
          "snippet": "private final ExecutorService pool = Executors.newFixedThreadPool(2);",
          "suggestion": "传入命名线程工厂（如 namedFactory(\"order-notify\")），或使用 ThreadPoolTaskExecutor#setThreadNamePrefix。"
        },
        {
          "rule_id": "TP-MONITOR-001",
          "rule_name": "线程池必须可观测",
          "message": "线程池 pool 没有关联到可观察的运行指标。",
          "severity": "warning",
          "line": 9,
          "column": 42,
          "snippet": "private final ExecutorService pool = Executors.newFixedThreadPool(2);",
          "suggestion": "为这个线程池暴露 getQueue().size()、getActiveCount()、getCompletedTaskCount() 等运行指标，并单独统计拒绝次数。"
        },
        {
          "rule_id": "TP-SHUTDOWN-004",
